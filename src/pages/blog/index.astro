---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
// Fallback cover for posts without a heroImage, so every card keeps the same shape.
import FallbackCover from '../../assets/blog-placeholder-1.jpg';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 960px;
			}
			ul {
				display: flex;
				flex-wrap: wrap;
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				/* Each post is its own card, so its image, title and description
				   clearly read as one item. border-box is required because the
				   page has no global box-sizing rule. */
				box-sizing: border-box;
				width: 100%;
				text-align: center;
				background: #fff;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 16px;
				padding: 1.5rem;
				box-shadow:
					0 2px 8px rgba(var(--black), 6%),
					0 8px 24px rgba(var(--gray), 14%);
				transition:
					box-shadow 0.2s ease,
					transform 0.2s ease;
			}
			ul li:hover {
				box-shadow: var(--box-shadow);
				transform: translateY(-2px);
			}
			ul li * {
				text-decoration: none;
				transition: 0.2s ease;
			}
			ul li img {
				width: 100%;
				margin-bottom: 0.5rem;
				border-radius: 12px;
			}
			ul li a {
				display: block;
			}
			.title {
				margin: 0;
				color: rgb(var(--black));
				line-height: 1;
				font-size: 2.369rem;
			}
			.date {
				margin: 0;
				color: rgb(var(--gray));
			}
			.description {
				margin: 0.5em 0 0.35em;
				color: rgb(var(--gray-dark));
				font-size: 0.85em;
				line-height: 1.5;
			}
			ul li a:hover h4,
			ul li a:hover .date {
				color: rgb(var(--accent));
			}
			@media (max-width: 720px) {
				ul {
					gap: 0.5em;
				}
				.title {
					font-size: 1.563rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				<ul>
					{
						posts.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`}>
									<Image
										width={960}
										height={480}
										src={post.data.heroImage ?? FallbackCover}
										alt=""
									/>
									<h4 class="title">{post.data.title}</h4>
									<p class="description">{post.data.description}</p>
									<p class="date">
										<FormattedDate date={post.data.pubDate} />
									</p>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
